CORS_ORIGIN=http://localhost:5174
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_SCRIPT_TTS_MODEL=gpt-4o-mini-tts
OPENAI_SCRIPT_TTS_VOICE=nova
OPENAI_SCRIPT_TTS_SPEED=0.85
OPENAI_SCRIPT_TTS_INSTRUCTIONS=Speak Mandarin Chinese slowly, clearly, warmly, and energetically for young learners. Keep tones precise, add tiny pauses after phrases, and sound encouraging rather than dramatic.
# Optional/experimental: Qwen3-TTS support for frontend/scripts/generate_script_sessions.py
# (Singapore endpoint shown; use a region-matched key + endpoint)
DASHSCOPE_API_KEY=
DASHSCOPE_TTS_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1
QWEN_SCRIPT_TTS_MODEL=qwen3-tts-instruct-flash
QWEN_SCRIPT_TTS_LANGUAGE_TYPE=Chinese
QWEN_SCRIPT_TTS_VOICE=Serena
QWEN_SCRIPT_TTS_OPTIMIZE_INSTRUCTIONS=true
# Optional global instruction override for Qwen instruct model.
# If empty, frontend/scripts/generate_script_sessions.py falls back to
# OPENAI_SCRIPT_TTS_INSTRUCTIONS and then its built-in default instructions.
QWEN_SCRIPT_TTS_INSTRUCTIONS=
# Optional: only for scripts/generate_reference_audio.py when using --engine openai (natural TTS samples)
# OPENAI_TTS_MODEL=tts-1-hd
# OPENAI_TTS_VOICE=nova
DEV_FAKE_EVALUATION=false

# local ASR (sherpa-onnx SenseVoice INT8)
LOCAL_ASR_PRELOAD=true
SENSEVOICE_MODEL_DIR=./models/sensevoice-int8
SENSEVOICE_LANGUAGE=zh
SENSEVOICE_NUM_THREADS=1
# Optional sherpa-onnx CPU provider configuration (default is plain cpu).
# SENSEVOICE_PROVIDER=cpu:/absolute/path/to/sensevoice_ort_lowmem.config

# realtime input gating (applies to /evaluate/local and /evaluate in realtime mode)
MIN_REALTIME_AUDIO_BYTES=9000
MIN_REALTIME_AUDIO_RMS=0.006
MIN_REALTIME_AUDIO_PEAK=0.045
MIN_REALTIME_ACTIVE_RATIO=0.025
MIN_REALTIME_ACTIVE_MS=120

# local ASR VAD (Sherpa Silero VAD)
LOCAL_ASR_VAD_ENABLED=true
LOCAL_ASR_VAD_MODEL_PATH=./models/silero_vad.onnx
LOCAL_ASR_VAD_MIN_SPEECH_MS=140
LOCAL_ASR_VAD_MIN_SPEECH_RATIO=0.08

# realtime mode uses deterministic pinyin diagnostics only (no contour)
# practice mode runs contour analysis for richer coaching
